{
  "goofy-write-guard": {
    "PreToolUse": [
      { "matcher": "write_to_file",              "hooks": [{ "type": "command", "command": "python3 hooks/guard.py", "timeout": 10 }] },
      { "matcher": "replace_file_content",       "hooks": [{ "type": "command", "command": "python3 hooks/guard.py", "timeout": 10 }] },
      { "matcher": "multi_replace_file_content", "hooks": [{ "type": "command", "command": "python3 hooks/guard.py", "timeout": 10 }] },
      { "matcher": "run_command",                "hooks": [{ "type": "command", "command": "python3 hooks/guard.py", "timeout": 10 }] }
    ]
  }
}
